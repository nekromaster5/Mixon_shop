SECRET_KEY =  'PUT YOUR SECRET KEY IN HERE'
DB_NAME = 'PUT YOUR DB NAME IN HERE'
DB_USER = 'PUT YOUR DB USER LOGIN IN HERE'
DB_PASSWORD = 'PUT YOUR DB USER PASSWORD IN HERE'
DB_HOST = 'PUT YOUR DB HOST IN HERE'
DB_PORT = 'PUT YOUR DB PORT IN HERE'

# Необязательно: если не заполнить, письма (активация аккаунта, сброс пароля)
# просто печатаются в консоль сервера вместо реальной отправки.
EMAIL_HOST = ''
EMAIL_PORT = '587'
EMAIL_HOST_USER = ''
EMAIL_HOST_PASSWORD = ''
EMAIL_USE_TLS = 'true'
DEFAULT_FROM_EMAIL = 'no-reply@mixon-shop.local'

# Только для settings.prod (боевой сервер) — обязательны, сервер не запустится
# без них. DB_ENGINE=mysql переключает базу с SQLite на MySQL (см. выше).
DB_ENGINE = 'mysql'
ALLOWED_HOSTS = 'example.com,www.example.com'

# Необязательно, только для settings.prod:
CSRF_TRUSTED_ORIGINS = 'https://example.com,https://www.example.com'
# 'false', если HTTPS ещё не настроен (не рекомендуется на реальном проде)
SECURE_SSL_REDIRECT = 'true'
# 'true', если перед gunicorn стоит nginx/балансировщик, сам терминирующий HTTPS
BEHIND_HTTPS_PROXY = 'false'

# Необязательно: ключ для Google Maps (карта филиалов на страницах
# оформления заказа и контактов). Без ключа карта просто не подгрузится.
GOOGLE_MAPS_API_KEY = ''

# 'true' — писать логи ещё и в logs/app.log (с ротацией), помимо консоли.
LOG_TO_FILE = 'false'
