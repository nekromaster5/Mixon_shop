msgid "Введите промокод."
msgstr "Введіть промокод."

msgid "Этот промокод уже применен."
msgstr "Цей промокод уже застосовано."

#, javascript-format
msgid "Промокод применен! Ваша скидка: %s"
msgstr "Промокод застосовано! Ваша знижка: %s"

#, javascript-format
msgid "Ошибка: %s"
msgstr "Помилка: %s"

msgid "Свернуть >>"
msgstr "Згорнути >>"

msgid "Детально >>"
msgstr "Детально >>"

msgid "Развернуть"
msgstr "Розгорнути"

msgid "Свернуть"
msgstr "Згорнути"

msgid "Товар добавлен в корзину!"
msgstr "Товар додано до кошика!"

msgid "Ошибка при добавлении товара."
msgstr "Помилка під час додавання товару."

msgid "Способ доставки не выбран"
msgstr "Спосіб доставки не вибрано"

msgid "Способ оплаты не выбран"
msgstr "Спосіб оплати не вибрано"

msgid "Комментариев нет"
msgstr "Коментарів немає"

msgid "Не удалось обновить сравнение. Попробуйте ещё раз."
msgstr "Не вдалося оновити порівняння. Спробуйте ще раз."

msgid "Пожалуйста, выберите способ доставки."
msgstr "Будь ласка, виберіть спосіб доставки."

msgid "Пожалуйста, выберите филиал для доставки."
msgstr "Будь ласка, виберіть філію для доставки."

msgid "Пожалуйста, выберите способ оплаты."
msgstr "Будь ласка, виберіть спосіб оплати."

msgid "Пожалуйста, укажите ваше имя."
msgstr "Будь ласка, вкажіть ваше ім’я."

msgid "Пожалуйста, укажите хотя бы телефон или email для связи."
msgstr "Будь ласка, вкажіть хоча б телефон або email для зв’язку."

msgid "Корзина пуста. Добавьте товары перед оформлением заказа."
msgstr "Кошик порожній. Додайте товари перед оформленням замовлення."

msgid "Ваш заказ принят"
msgstr "Ваше замовлення прийнято"

msgid "Произошла ошибка при создании заказа. Пожалуйста, попробуйте снова."
msgstr "Сталася помилка під час створення замовлення. Будь ласка, спробуйте ще раз."

msgid "Войдите в аккаунт, чтобы добавлять товары в избранное."
msgstr "Увійдіть в акаунт, щоб додавати товари до обраного."

msgid "Не удалось обновить избранное. Попробуйте ещё раз."
msgstr "Не вдалося оновити обране. Спробуйте ще раз."

msgid "Пароли не совпадают"
msgstr "Паролі не збігаються"

msgid "Быстрый заказ"
msgstr "Швидке замовлення"

msgid "Хочу дешевле"
msgstr "Хочу дешевше"

msgid "Оставьте имя и телефон — менеджер перезвонит и оформит заказ."
msgstr "Залиште ім’я та телефон — менеджер зателефонує й оформить замовлення."

msgid "Оставьте контакты — мы сообщим, если сможем предложить цену ниже."
msgstr "Залиште контакти — ми повідомимо, якщо зможемо запропонувати нижчу ціну."

msgid "Упаковка:"
msgstr "Упаковка:"

msgid "Цвет:"
msgstr "Колір:"

msgid "Не удалось отправить заявку."
msgstr "Не вдалося надіслати заявку."

msgid "Не удалось отправить заявку. Попробуйте ещё раз."
msgstr "Не вдалося надіслати заявку. Спробуйте ще раз."
